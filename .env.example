NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/login_system
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Support Team

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
PUBLIC_API_BASE_URL=
PUBLIC_LOGIN_URL=http://localhost:3000
PUBLIC_MULTIPLAYER_URL=http://localhost:3001

UPLOAD_MAX_FILE_SIZE_MB=500

OPENAI_API_KEY=
OPENAI_QUIZ_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=low

EUROBOT_API_URL=
EUROBOT_SERVICE_API_KEY=
EUROBOT_SERVICE_CLIENT=training
EUROBOT_SERVICE_API_KEY_HEADER=X-Eurobot-Service-Key
EUROBOT_CHAT_BACKEND=responses
EUROBOT_DEFAULT_KB_PREFIX=training
EUROBOT_ENABLE_TTS=true
TRAINING_TENANT_CODE=default

ENABLE_AUTO_SEED_MASTER=true
MASTER_USERNAME=admin
MASTER_EMAIL=admin@master.com
MASTER_PASSWORD=change-me
