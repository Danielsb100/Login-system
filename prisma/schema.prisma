generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MASTER
}

enum AssignedRole {
  STUDENT
  TEACHER
  TUTOR
  BUSINESS_MENTOR
  COORDINATOR
  ADMIN
  GUEST
  SUPER_ADMIN
}

enum ConsentKind {
  TERMS_AND_PRIVACY
  MARKETING_EMAILS
  PROFILE_DISCOVERY
  WORLD_PROFILE_CARD
}

enum NotificationType {
  MODULE_PUBLISHED
  FORUM_REPLY
  QUIZ_SUBMITTED
  EVENT_INVITE
  ENROLLMENT_CREATED
  FEEDBACK_RECEIVED
  SYSTEM_REMINDER
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReminderStatus {
  OPEN
  COMPLETED
  DISMISSED
}

enum TaskQueueStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  email         String         @unique
  password_hash  String
  role           Role           @default(USER)
  profilePicture String?
  isVerified     Boolean        @default(false)
  verificationCode String?
  documents      Document[]
  
  // New relations
  modules       TrainingModule[] @relation("MasterModules")
  submissions   QuizSubmission[]
  threads       ForumThread[]
  replies       ForumReply[]
  accessLogs    ModuleAccessLog[]
  videoProgress ModuleVideoProgress[]
  downloads     ModuleDocumentDownload[]
  placements    WorldModulePlacement[] @relation("MasterPlacements")
  auditLogs     AuditLog[]
  profile       UserProfile?
  preferences   UserPreference?
  roleAssignments UserRoleAssignment[]
  consentRecords ConsentRecord[]
  passwordResetTokens PasswordResetToken[]
  portfolioItems PortfolioItem[]
  notifications Notification[] @relation("NotificationRecipient")
  actorNotifications Notification[] @relation("NotificationActor")
  reminders Reminder[]
  taskQueueItems TaskQueueItem[]
  ownedCourses Course[] @relation("CourseOwner")
  enrollments Enrollment[]
  moduleCompletions ModuleCompletion[]
  landingPages  LandingPage[] @relation("MasterLandingPages")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UserProfile {
  id              Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String?
  headline         String?
  bio              String?
  interests        String[] @default([])
  skills           String[] @default([])
  spokenLanguages  String[] @default([])
  timezone         String?
  location         String?
  organization     String?
  course           String?
  websiteUrl       String?
  linkedinUrl      String?
  githubUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserPreference {
  id                    Int      @id @default(autoincrement())
  userId                 Int      @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language               String   @default("pt-BR")
  theme                  String   @default("system")
  emailNotifications     Boolean  @default(true)
  marketingEmails        Boolean  @default(false)
  allowProfileDiscovery  Boolean  @default(true)
  showProfileInWorld     Boolean  @default(true)
  allowDirectMessages    Boolean  @default(true)
  reduceMotion           Boolean  @default(false)
  highContrast           Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model UserRoleAssignment {
  id         Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        AssignedRole
  active      Boolean      @default(true)
  isPrimary   Boolean      @default(false)
  assignedAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, role])
}

model ConsentRecord {
  id         Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ConsentKind
  granted     Boolean
  version     String
  source      String      @default("system")
  metadata    Json?
  createdAt   DateTime    @default(now())
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
}

model PortfolioItem {
  id          Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType     String   @default("LINK")
  title        String
  description  String?
  url          String?
  highlight    Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id               Int                  @id @default(autoincrement())
  userId           Int
  user             User                 @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  status           NotificationStatus   @default(UNREAD)
  priority         NotificationPriority @default(MEDIUM)
  title            String
  message          String
  actionUrl        String?
  actorUserId      Int?
  actorUser        User?                @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  sourceEntityType String?
  sourceEntityId   Int?
  metadata         Json?
  readAt           DateTime?
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([userId, status, createdAt])
  @@index([type, createdAt])
}

model Reminder {
  id               Int                  @id @default(autoincrement())
  userId           Int
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType     @default(SYSTEM_REMINDER)
  status           ReminderStatus       @default(OPEN)
  priority         NotificationPriority @default(MEDIUM)
  title            String
  description      String?
  dueAt            DateTime?
  actionUrl        String?
  sourceEntityType String?
  sourceEntityId   Int?
  metadata         Json?
  completedAt      DateTime?
  dismissedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([userId, status, dueAt])
}

model TaskQueueItem {
  id               Int                  @id @default(autoincrement())
  userId           Int
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  status           TaskQueueStatus      @default(PENDING)
  priority         NotificationPriority @default(MEDIUM)
  title            String
  summary          String?
  bucket           String               @default("TODAY")
  scheduledFor     DateTime?
  dueAt            DateTime?
  actionUrl        String?
  sourceEntityType String?
  sourceEntityId   Int?
  metadata         Json?
  completedAt      DateTime?
  dismissedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([userId, status, bucket, dueAt])
}

model Document {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  type            String   // e.g., 'application/pdf'
  data            Bytes?   // Legacy inline binary storage; new uploads use external asset storage.
  storageProvider String   @default("database")
  storageKey      String?
  sizeBytes       Int?
  
  // New relation
  moduleDocs ModuleDocument[]

  createdAt DateTime @default(now())
}

// New Enums
enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlacementStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  CANCELLED
}

enum LogSource {
  DASHBOARD
  MULTIPLAYER_WORLD
}

// New Models

model TrainingModule {
  id             Int          @id @default(autoincrement())
  ownerMasterId  Int
  master         User         @relation("MasterModules", fields: [ownerMasterId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  coverImage     String?
  status         ModuleStatus @default(DRAFT)
  
  videos         ModuleVideo[]
  documents      ModuleDocument[]
  quizzes        Quiz[]
  submissions    QuizSubmission[]
  threads        ForumThread[]
  accessLogs     ModuleAccessLog[]
  placements     WorldModulePlacement[]
  courseModules  CourseModule[]
  completions    ModuleCompletion[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Course {
  id              Int                    @id @default(autoincrement())
  ownerMasterId   Int
  owner           User                   @relation("CourseOwner", fields: [ownerMasterId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  coverImage      String?
  status          CourseStatus           @default(DRAFT)
  sceneId         String                 @unique
  courseModules   CourseModule[]
  enrollments     Enrollment[]
  completions     ModuleCompletion[]
  placements      WorldModulePlacement[]
  landingPage     LandingPage? @relation("CourseLandingPage")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}


model CourseModule {
  id              Int                    @id @default(autoincrement())
  courseId        Int
  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId        Int
  module          TrainingModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  orderIndex      Int
  isRequired      Boolean                @default(true)
  requireQuizPass Boolean                @default(false)
  minimumQuizScore Float?
  roomLabel       String?
  placement       WorldModulePlacement?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([courseId, moduleId])
}

model Enrollment {
  id              Int                    @id @default(autoincrement())
  courseId        Int
  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId          Int
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus       @default(ENROLLED)
  progressPercent Float                  @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([courseId, userId])
}

model ModuleCompletion {
  id              Int                    @id @default(autoincrement())
  courseId        Int
  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId        Int
  module          TrainingModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId          Int
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          LogSource              @default(DASHBOARD)
  completedAt     DateTime               @default(now())

  @@unique([courseId, moduleId, userId])
}

model ModuleVideo {
  id         Int          @id @default(autoincrement())
  moduleId   Int
  module     TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  url        String
  order      Int
  progress   ModuleVideoProgress[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ModuleDocument {
  id         Int          @id @default(autoincrement())
  moduleId   Int
  module     TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  documentId Int
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  order      Int
  downloads  ModuleDocumentDownload[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Quiz {
  id         Int          @id @default(autoincrement())
  moduleId   Int
  module     TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  order      Int
  questions  QuizQuestion[]
  submissions QuizSubmission[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model QuizQuestion {
  id         Int          @id @default(autoincrement())
  quizId     Int
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text       String
  order      Int
  options    QuizOption[]
  answers    QuizAnswer[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model QuizOption {
  id         Int          @id @default(autoincrement())
  questionId Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean
  answers    QuizAnswer[]
}

model QuizSubmission {
  id            Int          @id @default(autoincrement())
  moduleId      Int
  module        TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizId        Int?
  quiz          Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Float
  attemptNumber Int
  answers       QuizAnswer[]
  createdAt     DateTime     @default(now())
}

model QuizAnswer {
  id           Int          @id @default(autoincrement())
  submissionId Int
  submission   QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   Int
  question     QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId     Int
  option       QuizOption     @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model ForumThread {
  id        Int          @id @default(autoincrement())
  moduleId  Int
  module    TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  replies   ForumReply[]
  createdAt DateTime     @default(now())
}

model ForumReply {
  id        Int          @id @default(autoincrement())
  threadId  Int
  thread    ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime     @default(now())
}

model ModuleAccessLog {
  id          Int            @id @default(autoincrement())
  moduleId    Int
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId      Int
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  placementId Int?           // Optional: link to a specific placement
  sceneId     String?        // Optional: link to a specific scene/world
  source      LogSource
  timestamp   DateTime       @default(now())
}

model ModuleVideoProgress {
  id        Int          @id @default(autoincrement())
  videoId   Int
  video     ModuleVideo  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress  Float        // 0 to 100
  completed Boolean      @default(false)
  updatedAt DateTime     @updatedAt

  @@unique([videoId, userId])
}

model ModuleDocumentDownload {
  id          Int            @id @default(autoincrement())
  moduleDocId Int
  moduleDoc   ModuleDocument @relation(fields: [moduleDocId], references: [id], onDelete: Cascade)
  userId      Int
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp   DateTime       @default(now())
}

model WorldModulePlacement {
  id            Int             @id @default(autoincrement())
  ownerMasterId Int
  master        User            @relation("MasterPlacements", fields: [ownerMasterId], references: [id], onDelete: Cascade)
  courseId      Int?
  course        Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseModuleId Int?           @unique
  courseModule  CourseModule?   @relation(fields: [courseModuleId], references: [id], onDelete: SetNull)
  moduleId      Int?
  module        TrainingModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  sceneId       String
  objectType    String
  label         String?
  positionX     Float
  positionY     Float
  positionZ     Float
  rotationX     Float
  rotationY     Float
  rotationZ     Float
  scaleX        Float
  scaleY        Float
  scaleZ        Float
  status        PlacementStatus @default(ACTIVE)
  modelData      Bytes?          // Binary GLB file
  idleAnim       String?         // Idle animation name
  interactedAnim String?         // Interaction animation name
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   Int?
  details    Json?
  createdAt  DateTime @default(now())
}

model LandingPage {
  id              Int      @id @default(autoincrement())
  ownerMasterId   Int
  master          User     @relation("MasterLandingPages", fields: [ownerMasterId], references: [id], onDelete: Cascade)
  title           String
  content         Json     // Raw modular builder JSON
  compiledHtml    String?  @db.Text
  compiledCss     String?  @db.Text
  courseId        Int?     @unique
  course          Course?  @relation("CourseLandingPage", fields: [courseId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
